# --- Allgemein ---
# Oeffentliche Basis-URL ohne Schraegstrich am Ende.
# Wird fuer Canonical-URLs, OpenGraph und die Sitemap gebraucht.
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# --- Social Media ---
# Ohne diese Werte greifen die Standardprofile in src/lib/site.ts.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/salzburgsucht/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@salzburgsucht

# --- Supabase (Region Frankfurt) — OPTIONAL ---
# Wird fuer den Betrieb NICHT gebraucht: Anfragen werden per E-Mail zugestellt
# (siehe unten). Diese Werte speichern Eingaenge nur ZUSAETZLICH und werden
# gebraucht, sobald ein Newsletter mit Double-Opt-In ansteht.
NEXT_PUBLIC_SUPABASE_URL=
# Oeffentlicher anon-Key. Darf im Browser landen — Row Level Security schuetzt.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-Role-Key. NIEMALS im Browser verwenden, nur serverseitig.
SUPABASE_SERVICE_ROLE_KEY=

# --- E-Mail — PFLICHT, sonst kommt keine Anfrage an ---
# Zwei Wege, EINER genuegt. Liegt SMTP_HOST vor, gewinnt SMTP.
# Welcher Weg genommen wird, entscheidet src/lib/mailer.ts.
#
# WEG 1 (empfohlen): das eigene Postfach der Domain. Kein Drittanbieter, keine
# Domainverifizierung, kein zusaetzlicher Auftragsverarbeiter in der
# Datenschutzerklaerung. Bei World4You: smtp.world4you.com, Port 587
# (STARTTLS). Die genauen Daten stehen im Kundenbereich beim Postfach.
SMTP_HOST=smtp.world4you.com
SMTP_PORT=587
SMTP_USER=
# Passwort des Postfachs. Der einzige geheime Wert hier — gehoert in
# .env.local und ins Vercel-Dashboard, nie in diese Datei.
SMTP_PASS=
#
# WEG 2: Resend. Nur noetig, wenn kein SMTP-Zugang vorliegt. Die Domain muss
# dort per DNS-Eintraegen verifiziert werden, sonst wird der Versand abgelehnt.
RESEND_API_KEY=
#
# Absender. Bei SMTP MUSS das dieselbe Adresse sein wie SMTP_USER — sonst
# weist der Server sie zurueck oder sie landet im Spam.
MAIL_FROM="Salzburgsucht <office@salzburgsucht.at>"
# Hierhin gehen die Kooperationsanfragen.
MAIL_TO=

# --- Reichweitenmessung (optional, erst nach Einwilligung aktiv) ---
# Es muss nur EINER dieser Dienste eingebunden werden. Die Abstraktion in
# src/lib/analytics/index.ts erkennt selbst, welcher vorhanden ist.
# Google Analytics 4:
NEXT_PUBLIC_GA_ID=
